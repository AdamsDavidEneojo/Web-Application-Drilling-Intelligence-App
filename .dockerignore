# .dockerignore - exclude unnecessary files from Docker build context

# Python cache and compilation
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.sublime-project
.sublime-workspace

# Version control
.git/
.gitignore
.gitattributes

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Model files (too large for build context)
rop_model.pkl
scaler.pkl
*.pkl

# Documentation
*.md
docs/
README.md

# Environment and config
.env
.env.local
.env.*.local

# OS files
Thumbs.db
.DS_Store

# GitHub workflows
.github/

# Development files
docker-compose.yml
docker-compose.*.yml
Dockerfile.dev
.dockerignore
